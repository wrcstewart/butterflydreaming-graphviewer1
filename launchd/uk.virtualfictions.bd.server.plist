<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>uk.virtualfictions.bd.server</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string>
    <string>/Users/williamstewart2/butterflydreaming_graphviewer1/launchd/start_bd_server.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/williamstewart2/butterflydreaming_graphviewer1</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- Restarted if it exits for any reason. To stop it deliberately use
       launchctl bootout, NOT kill: a killed server is simply restarted. -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <!-- The same log the client console is forwarded into. -->
  <key>StandardOutPath</key><string>/private/tmp/bd_server.log</string>
  <key>StandardErrorPath</key><string>/private/tmp/bd_server.log</string>
</dict></plist>
